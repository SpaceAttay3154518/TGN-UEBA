{
  "schema_version": 1,
  "purpose": "Dataset and evaluation registry for EMDD, the GIDS state-of-the-art evaluation, and KAIROS-comparable experiments.",
  "training_ready_root": "../data/training_ready",
  "suites": {
    "emdd_primary": [
      "cert_r42"
    ],
    "gids_state_of_art_evaluated": [
      "lanl_comprehensive",
      "optc",
      "cicids2017",
      "enterprise_private"
    ],
    "kairos_comparability": [
      "streamspot",
      "darpa_e3_theia",
      "darpa_e3_cadets",
      "darpa_e3_clearscope",
      "darpa_e5_theia",
      "darpa_e5_cadets",
      "darpa_e5_clearscope",
      "optc"
    ],
    "surveyed_not_evaluated": [
      "uci_messages",
      "digg",
      "arxiv_hep_th",
      "dblp",
      "ctu13",
      "ton_iot",
      "nf_unsw_nb15_v2",
      "nf_cse_cic_ids2018_v2",
      "nf_ton_iot",
      "bot_iot",
      "nf_bot_iot",
      "pivoting",
      "cora",
      "citeseer",
      "pubmed"
    ]
  },
  "normalized_event_contract": {
    "required_columns": [
      "event_id",
      "timestamp",
      "timestamp_s",
      "src_id",
      "dst_id",
      "src_type",
      "dst_type",
      "event_type",
      "event_type_id",
      "dst_type_id",
      "attack_label",
      "split"
    ],
    "storage": "partitioned Parquet, split then chronological partition",
    "label_granularities": [
      "edge",
      "15-minute-window",
      "graph"
    ],
    "leakage_rule": "training and validation decisions must not use test labels or test scores"
  },
  "datasets": {
    "cert_r42": {
      "display_name": "CERT Insider Threat Test Dataset r4.2",
      "status": "ready",
      "adapter": "cert_full",
      "benchmark_role": "EMDD primary slow-memory-drift corpus",
      "raw_required": [],
      "prepared_directory": "cert_r42",
      "label_granularity": "edge",
      "role_source": "explicit LDAP organizational hierarchy",
      "public": true,
      "source_url": "https://kilthub.cmu.edu/articles/dataset/Insider_Threat_Test_Dataset/12841247"
    },
    "lanl_comprehensive": {
      "display_name": "LANL Comprehensive, Multi-Source Cyber-Security Events",
      "status": "raw_required",
      "adapter": "lanl",
      "benchmark_role": "public dataset actually evaluated by the GIDS state-of-the-art paper",
      "raw_required": [
        "auth.txt.gz",
        "proc.txt.gz",
        "flows.txt.gz",
        "dns.txt.gz",
        "redteam.txt.gz"
      ],
      "prepared_directory": "lanl_comprehensive",
      "published_events": 1648275307,
      "gids_preprocessed_events": 1051430459,
      "published_compressed_size_gb": 10.7,
      "duration_days": 58,
      "label_granularity": "edge",
      "role_source": "structural proxy only; no employee-role directory is released",
      "public": true,
      "source_url": "https://csr.lanl.gov/data/cyber1/",
      "split_policy": "train before first red-team event; reserve the final benign pre-attack day for validation; test from first red-team event onward"
    },
    "cicids2017": {
      "display_name": "CIC-IDS-2017 Generated Labelled Flows",
      "status": "raw_required",
      "adapter": "cicids2017",
      "benchmark_role": "public dataset actually evaluated by the GIDS state-of-the-art paper",
      "raw_required": [
        "GeneratedLabelledFlows.zip"
      ],
      "prepared_directory": "cicids2017",
      "published_events": 2830742,
      "published_hosts_or_ips": 19129,
      "duration_days": 5,
      "label_granularity": "edge",
      "role_source": "network service-role proxy only; no organizational roles are released",
      "public": true,
      "source_url": "https://www.unb.ca/cic/datasets/ids-2017.html",
      "split_policy": "Monday benign traffic is temporally split into train then validation; Tuesday-Friday are test",
      "scientific_constraint": "Use GeneratedLabelledFlows, not MachineLearningCSV: graph construction requires source IP, destination IP, and timestamp."
    },
    "enterprise_private": {
      "display_name": "Anonymous enterprise dataset from the GIDS state-of-the-art study",
      "status": "unavailable_private",
      "adapter": null,
      "benchmark_role": "private dataset actually evaluated by the GIDS state-of-the-art paper",
      "raw_required": [],
      "prepared_directory": "enterprise_private",
      "published_events": 10338002425,
      "published_hosts_or_ips": 18425098,
      "duration_days": 101,
      "label_granularity": "edge",
      "role_source": "not disclosed",
      "public": false,
      "source_url": null,
      "blocker": "The paper describes an anonymous newly collected enterprise corpus but provides no public data release."
    },
    "streamspot": {
      "display_name": "Manzoor et al. StreamSpot ALL",
      "status": "acquirable",
      "adapter": "streamspot",
      "benchmark_role": "KAIROS graph-level comparability dataset",
      "raw_required": [
        "all.tar.gz"
      ],
      "prepared_directory": "streamspot",
      "graphs": 600,
      "attack_graphs": 100,
      "label_granularity": "graph",
      "role_source": "kernel-object type only",
      "public": true,
      "source_url": "https://github.com/sbustreamspot/sbustreamspot-data",
      "source_revision": "07942da41ae3ba7202b146c758fcf0c30d2cb7b6",
      "split_policy": "KAIROS: graph 0 of each benign scenario for train, graphs 1-24 for validation, graphs 25-99 for test, and all attack graphs 300-399 for test"
    },
    "darpa_e3_theia": {
      "display_name": "DARPA TC Engagement 3 - THEIA",
      "status": "raw_required",
      "adapter": "darpa_cdm18",
      "benchmark_role": "KAIROS provenance benchmark",
      "raw_required": ["*.json", "ground_truth.json"],
      "prepared_directory": "darpa_e3_theia",
      "label_granularity": "15-minute-window",
      "role_source": "kernel-object type and hierarchical path",
      "public": true,
      "source_url": "https://github.com/darpa-i2o/Transparent-Computing/blob/master/README-E3.md",
      "dates": {"train": ["2018-04-03", "2018-04-04", "2018-04-05"], "validation": ["2018-04-09"], "test": ["2018-04-10", "2018-04-11", "2018-04-12"]}
